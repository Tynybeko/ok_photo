# Vercel → Storage → Blob → .env.local (не коммитить!)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Секрет для генерации паролей (меняются каждые 2 дня)
# Узнать текущие: /api/passwords?key=ВАШ_PASSWORD_SECRET
PASSWORD_SECRET=kirova9898topa

# Устарело — пароли теперь через PASSWORD_SECRET
# ADMIN_PASSWORD=tinytiny

# Cookies одной строкой для импорта с OK.ru на Vercel (опционально)
OK_COOKIES=

# Лимит фото за один импорт (Hobby: лучше 30–50)
IMPORT_MAX=80

# --- WhatsApp: пароли каждые 2 дня ---
# Green API (рекомендуется, есть группы): https://green-api.com
GREEN_API_ID=
GREEN_API_TOKEN=
# chatId группы (120363...@g.us) — сюда пароль ПРОСМОТРА
WHATSAPP_GROUP_CHAT_ID=
# твой личный chatId (79001234567@c.us) — сюда пароль РЕДАКТИРОВАНИЯ
WHATSAPP_ADMIN_CHAT_ID=

# Альтернатива CallMeBot (только на один номер, без группы): callmebot.com
# WHATSAPP_VIEW_PHONE=+79001234567
# CALLMEBOT_VIEW_APIKEY=
# WHATSAPP_ADMIN_PHONE=+79001234567
# CALLMEBOT_ADMIN_APIKEY=

SITE_URL=https://ok-photo.vercel.app
# Vercel Cron (сгенерируй случайную строку): Settings → CRON_SECRET
CRON_SECRET=
